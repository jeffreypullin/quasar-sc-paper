/*
 * LSF farm settings for the Sanger Institute.
 * Loaded with: ./nextflow run main.nf -profile sanger --datasets cytoimmgen
 *
 * conf/csd3.config is still included first from nextflow.config; every label
 * below re-sets executor = 'lsf' so Slurm settings cannot leak through.
 */

workDir = '/lustre/scratch124/humgen/projects_v2/healthy_imm_expr/cytoimmgen_quasar/nextflow'

conda {
  enabled = true
  useMicromamba = true
}

executor {
  name = 'lsf'
  queueSize = 300
  pollInterval = '1 min'
  submitRateLimit = '10 sec'
  perJobMemLimit = true
}

env {
  TMPDIR = '/lustre/scratch124/humgen/projects_v2/healthy_imm_expr/cytoimmgen_quasar/tmp'
}

params {
  quasar_bin = '/software/teamtrynka/installs/quasar/bin/quasar'
}

process {
  executor = 'lsf'
  // Confirm the LSF group with `groups` / farm docs before a long run.
  clusterOptions = '-G teamtrynka'
  beforeScript = 'module load ISG/python/3.11.0 || true'

  withLabel: tiny {
    executor = 'lsf'
    cpus = 12
    memory = '120 GB'
    queue = 'normal'
    time = '30m'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: high_mem {
    executor = 'lsf'
    cpus = 10
    memory = '80 GB'
    queue = 'normal'
    time = '40m'
    clusterOptions = '-G teamtrynka'
  }
  withName: COLLATE_SAIGEQTL_INPUT {
    memory = '140 GB'
  }
  withLabel: mega_mem {
    executor = 'lsf'
    cpus = 20
    memory = '160 GB'
    queue = 'hugemem'
    time = '2h'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: long_mega_mem {
    executor = 'lsf'
    cpus = 20
    memory = '160 GB'
    queue = 'hugemem'
    time = '6h'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: randolph_genotypes {
    executor = 'lsf'
    cpus = 4
    memory = '16 GB'
    queue = 'normal'
    time = '6h'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: pb_quasar {
    executor = 'lsf'
    cpus = 3
    memory = '16 GB'
    queue = 'normal'
    time = '6h'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: saigeqtl {
    executor = 'lsf'
    cpus = 2
    memory = '10 GB'
    queue = 'long'
    time = '12h'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: castie {
    executor = 'lsf'
    cpus = 8
    memory = '40 GB'
    queue = 'long'
    time = '12h'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: sc_quasar {
    executor = 'lsf'
    cpus = 6
    memory = '20 GB'
    queue = 'long'
    time = '8h'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: sc_quasar_perm {
    executor = 'lsf'
    cpus = 6
    memory = '20 GB'
    queue = 'long'
    time = '8h'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: sc_quasar_gwas {
    executor = 'lsf'
    cpus = 10
    memory = '80 GB'
    queue = 'normal'
    time = '4h'
    clusterOptions = '-G teamtrynka'
  }
  withName: RUN_QUASAR_PB_GWAS {
    cpus = 1
    memory = '50 GB'
  }
  withLabel: micro {
    executor = 'lsf'
    cpus = 6
    memory = '10 GB'
    queue = 'normal'
    time = '30m'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: nano {
    executor = 'lsf'
    cpus = 2
    memory = '20 GB'
    queue = 'normal'
    time = '5m'
    clusterOptions = '-G teamtrynka'
  }
  withLabel: long_nano {
    executor = 'lsf'
    cpus = 2
    memory = '10 GB'
    queue = 'normal'
    time = '80m'
    clusterOptions = '-G teamtrynka'
  }
  withName: 'RUN_QUASAR_SC_CYTOIMMGEN' {
    publishDir = [
      path: 'output/cytoimmgen',
      mode: 'copy',
      pattern: '*.{gz,txt}'
    ]
  }
}
